<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProductVersion>3.0</ProductVersion>
    <ProjectGuid>{7e186967-4e4b-46e5-bfb6-35f416c7023c}</ProjectGuid>
    <SchemaVersion>2.0</SchemaVersion>
    <OutputName>europlan31</OutputName>
    <OutputType>Package</OutputType>
    <WixTargetsPath Condition=" '$(WixTargetsPath)' == '' ">$(MSBuildExtensionsPath)\Microsoft\WiX\v3.0\Wix.targets</WixTargetsPath>
    <Name>Setup</Name>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <Cultures>de-DE;en-US</Cultures>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'UnitTest|x86' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'UnitTest|AnyCPU' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'UnitTest|Any CPU' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="europlan20.wxs" />
  </ItemGroup>
  <ItemGroup>
    <WixExtension Include="WixUtilExtension">
      <HintPath>$(WixExtDir)\WixUtilExtension.dll</HintPath>
    </WixExtension>
    <WixExtension Include="WixUIExtension">
      <HintPath>$(WixExtDir)\WixUIExtension.dll</HintPath>
    </WixExtension>
    <WixExtension Include="WixNetFxExtension">
      <HintPath>$(WixExtDir)\WixNetFxExtension.dll</HintPath>
    </WixExtension>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="imgs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="eula.rtf" />
    <Content Include="imgs\europlan-banner.bmp" />
    <Content Include="imgs\europlan-dlg.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="WixUI_de-DE.wxl" />
    <EmbeddedResource Include="WixUI_en-US.wxl" />
  </ItemGroup>
  <Import Project="$(WixTargetsPath)" />
  <!--
	To modify your build process, add your task inside one of the targets below and uncomment it.
	Other similar extension points exist, see Wix.targets.
	<Target Name="BeforeBuild">
	</Target>
	<Target Name="AfterBuild">
	</Target>
	-->
  <ItemGroup>
    <BootstrapperFile Include="Microsoft.Net.Framework.2.0">
      <ProductName>Microsoft .NET Framework 2.0</ProductName>
    </BootstrapperFile>
    <BootstrapperFile Include="Microsoft.Windows.Installer.3.1">
      <ProductName>Microsoft Windows Installer 3.1</ProductName>
    </BootstrapperFile>
  </ItemGroup>
  <Target Name="BootstrapperDE" Inputs="$(OutDir)$(TargetFileName)" Outputs="$(OutDir)\Setup.exe" Condition=" '$(OutputType)'=='package' ">
    <GenerateBootstrapper ApplicationName="Europlan 2.0" ApplicationFile="instmsi.exe" BootstrapperItems="@(BootstrapperFile)" ComponentsLocation="HomeSite" OutputPath="$(OutputPath)\de-DE\" Culture="de-DE" />
  </Target>
  <Target Name="BootstrapperEN" Inputs="$(OutDir)$(TargetFileName)" Outputs="$(OutDir)\Setup.exe" Condition=" '$(OutputType)'=='package' ">
    <GenerateBootstrapper ApplicationName="Europlan 2.0" ApplicationFile="instmsi.exe" BootstrapperItems="@(BootstrapperFile)" ComponentsLocation="HomeSite" OutputPath="$(OutputPath)\en-US\" Culture="en-US" />
  </Target>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WiX\v3.0\Wix.targets" />
  <PropertyGroup>
    <CoreBuildDependsOn>
      BuildOnlySettings;
      PrepareForBuild;
      PreBuildEvent;
      ResolveReferences;
      AddCompilerDefineConstants;
      CompileAndLink;
      GetTargetPath;
      IncrementalClean;
	  BootstrapperDE;
	  BootstrapperEN;
      PostBuildEvent
    </CoreBuildDependsOn>
    <PostBuildEvent>if $(ConfigurationName) == Debug exit 0

copy "$(SolutionDir)StartSetup\$(OutDir)instmsi.exe" "$(TargetDir)de-DE\instmsi.exe"
copy "$(TargetDir)de-DE\europlan31.msi" "$(TargetDir)de-DE\setup.msi"
cd $(ProjectDir)
for /F "tokens=1,2,3,4,5 delims=/.: " %%a in (%27utils\datetime%27) do set SUFFIX=%%c-%%b-%%a_%%d%%e
mkdir $(TargetDir)\setup-%SUFFIX%
mkdir $(TargetDir)\latest_setup
7z.exe a "$(TargetDir)setup-%SUFFIX%\europlan31-de.zip" "$(TargetDir)de-DE\instmsi.exe" "$(TargetDir)de-DE\setup.exe" "$(TargetDir)de-DE\setup.msi" || echo Postbuild: warning CS0003: German zip archive was not built
del "$(TargetDir)de-DE\setup.msi"
ChilkatZipSE.exe -u BLUESOSFX_7WD8XKDznOuG -cfg chilkat-settings-de.xml -exe "$(TargetDir)setup-%SUFFIX%\europlan31-de.exe" "$(TargetDir)setup-%SUFFIX%\europlan31-de.zip" || echo Postbuild: warning CS0004: German setup exe was not built
set ERRORLEVEL=0

rem english setup
copy "$(SolutionDir)StartSetup\$(OutDir)instmsi.exe" "$(TargetDir)en-US\instmsi.exe"
copy "$(TargetDir)en-US\europlan31.msi" "$(TargetDir)en-US\setup.msi"
echo "blub"
cd $(ProjectDir)
7z.exe a "$(TargetDir)setup-%SUFFIX%\europlan31-en.zip" "$(TargetDir)en-US\instmsi.exe" "$(TargetDir)en-US\setup.exe" "$(TargetDir)en-US\setup.msi" || echo Postbuild: warning CS0003: English zip archive was not built
del "$(TargetDir)en-US\setup.msi"
ChilkatZipSE.exe -u BLUESOSFX_7WD8XKDznOuG -cfg chilkat-settings-en.xml -exe "$(TargetDir)setup-%SUFFIX%\europlan31-en.exe" "$(TargetDir)setup-%SUFFIX%\europlan31-en.zip" || echo Postbuild: warning CS0004: English setup exe was not built
copy /y $(TargetDir)\setup-%SUFFIX%\%2a.exe $(TargetDir)\latest_setup
set ERRORLEVEL=0</PostBuildEvent>
  </PropertyGroup>
</Project>